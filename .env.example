# ---- Painel do administrador (obrigatórias para usar a página /admin) ----
# Senha de acesso ao painel
ADMIN_PASSWORD=
# Texto longo e aleatório (mínimo 16 caracteres). Usado para criptografar a chave e assinar a sessão.
# Se trocar este valor depois, será preciso cadastrar a chave da OpenAI de novo.
ADMIN_SECRET=

# ---- Armazenamento da chave (Upstash Redis) ----
# Preenchidas automaticamente ao conectar o Upstash Redis ao projeto na Vercel (Marketplace).
# Podem aparecer com os nomes KV_REST_API_URL e KV_REST_API_TOKEN, que também são aceitos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Opcionais ----
# Código de acesso: se definido, só quem digitar esse código no app consegue gerar textos.
ACCESS_CODE=
# Alternativa ao painel: chave da OpenAI direto no servidor (usada se nenhuma chave for cadastrada no painel).
OPENAI_API_KEY=
# Modelo usado quando nenhum for escolhido no painel
OPENAI_MODEL=gpt-4o-mini
